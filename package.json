{
  "name": "dsh-sql",
  "version": "0.6.6",
  "description": "DeepSeek Harness 数据库插件：SQLite / MySQL / PostgreSQL 结构探查、限流查询与写操作审批。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/update-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sql",
    "sqlite",
    "mysql",
    "postgresql",
    "database",
    "dsh-plugin",
    "deepseek",
    "ai-agent",
    "数据库"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.23.0",
    "@stardustlc/dsh-updates": "0.2.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-sql.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-sql/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-sql#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
